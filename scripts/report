#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
IMAGE="texlive/texlive:latest"

fail() {
    printf 'report: %s\n' "$1" >&2
    exit 1
}

usage() {
    printf 'Usage: %s {new|build|clean} <name> | list\n' "$0"
}

if [[ "${1:-}" == list && "$#" -eq 1 ]]; then
    find "$ROOT/projects" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' | LC_ALL=C sort
    exit 0
fi

if [[ "$#" -ne 2 ]]; then
    usage
    exit 1
fi

ACTION="$1"
NAME="$2"
[[ "$NAME" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || fail "invalid name: $NAME"
PROJECT="$ROOT/projects/$NAME"

case "$ACTION" in
    new)
        [[ ! -e "$PROJECT" && ! -L "$PROJECT" ]] || fail "already exists: $NAME"
        mkdir -- "$PROJECT"
        cp -- "$ROOT/projects/example/main.tex" "$PROJECT/main.tex"
        printf 'Created: %s\n' "$PROJECT"
        ;;
    build|clean)
        [[ -d "$PROJECT" && ! -L "$PROJECT" && -f "$PROJECT/main.tex" ]] || fail "project not found: $NAME"
        [[ ! -L "$PROJECT/build" && ! -L "$PROJECT/main.pdf" ]] || fail "symlinked output is not allowed: $NAME"
        if [[ "$ACTION" == clean ]]; then
            rm -rf -- "$PROJECT/build"
            rm -f -- "$PROJECT/main.pdf"
            printf 'Cleaned: %s\n' "$PROJECT"
            exit 0
        fi
        command -v docker >/dev/null 2>&1 || fail 'Docker is required'
        mkdir -p -- "$PROJECT/build"
        docker run --rm --user "$(id -u):$(id -g)" \
            --mount "type=bind,source=$PROJECT,target=/work" --workdir /work \
            --env HOME=/tmp "$IMAGE" \
            latexmk -xelatex -interaction=nonstopmode -halt-on-error -file-line-error -synctex=1 -outdir=build main.tex
        cp -- "$PROJECT/build/main.pdf" "$PROJECT/main.pdf"
        printf 'PDF: %s\n' "$PROJECT/main.pdf"
        ;;
    *)
        usage
        exit 1
        ;;
esac
