{
  "latex-workshop.latex.recipe.default": "PDF (Docker)",
  "latex-workshop.latex.recipes": [
    {
      "name": "PDF (Docker)",
      "tools": ["make-pdf"]
    }
  ],
  "latex-workshop.latex.tools": [
    {
      "name": "make-pdf",
      "command": "make",
      "args": ["-C", "%DIR%", "pdf"]
    }
  ],
  "latex-workshop.latex.outDir": "build",
  "latex-workshop.latex.autoBuild.run": "never"
}
